{
  "name": "famsun-agent-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:ui": "node tests/regression.mjs",
    "test:deployment": "node tests/deployment.mjs",
    "test:deployment-restart": "node tests/deployment-restart.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" tests/*.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
