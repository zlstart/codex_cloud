# Local development. No API key is required to create accounts or manage files.
# Keep .env private; it is intentionally excluded from Git and Docker builds.
AGENT_API_KEY=
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-5.6-luna
# Responses only. Provider must support custom tools and context_management.
AGENT_COMPACTION_THRESHOLD=32000

# OpenAI Traces is independent of the Responses model/provider above.
# Explicit opt-in plus an OpenAI key are required; never use a third-party key.
AGENT_TRACING_ENABLED=false
OPENAI_TRACING_API_KEY=
# When the dedicated tracing key is empty, OPENAI_API_KEY is the fallback.
AGENT_TRACING_WORKFLOW_NAME=FAMSUN conversation
# Prompt/model/tool inputs and outputs are excluded unless explicitly enabled.
AGENT_TRACING_INCLUDE_SENSITIVE_DATA=false
# OPENAI_AGENTS_DISABLE_TRACING=1 is also respected as an SDK-wide off switch.

DATA_DIR=./data
# SQLite only. Empty uses DATA_DIR/app.db in local development and Compose.
DATABASE_URL=
SANDBOX_BACKEND=docker
FAMSUN_SANDBOX_IMAGE=famsun-sandbox:latest
# Docker daemon request timeout; large images/slow storage can need >15 seconds.
FAMSUN_DOCKER_TIMEOUT_SECONDS=60
# Optional trusted CA bundle for sandbox HTTPS, mounted read-only.
# FAMSUN_SANDBOX_CA_BUNDLE=/path/to/combined-ca.pem
# Optional; set a unique value per deployment sharing the same Docker daemon.
# FAMSUN_DEPLOYMENT_ID=famsun-production
# Disabled prevents agent runs; account/file management remains available.
# SANDBOX_BACKEND=disabled

ALLOW_REGISTRATION=false
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
ALLOWED_MCP_HOSTS=
# MCP auth is optional. Store token values on the server only and set an
# extension's token_env field to its variable name (MCP_<NAME>_TOKEN).
# MCP_RESEARCH_TOKEN=
MAX_UPLOAD_MB=25
MAX_SESSION_MB=250
AGENT_MAX_TURNS=40
AGENT_TIMEOUT_SECONDS=900

# Compose only: use an ABSOLUTE DATA_DIR, e.g. /srv/famsun/data.
# Set these to the owning host user and Docker socket group. See DEPLOYMENT.md.
FAMSUN_UID=1000
FAMSUN_GID=1000
DOCKER_GID=
APP_PORT=8080
